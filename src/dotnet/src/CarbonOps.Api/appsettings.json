{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Persistence": {
    "UsePostgreSql": false,
    "PostgreSql": {
      "ConnectionString": "",
      "BootstrapOnStartup": false,
      "BootstrapMode": "ValidateOnly"
    }
  },
  "RateLimiting": {
    "Import": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Read": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "AllowedHosts": "*"
}
