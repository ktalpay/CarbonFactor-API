{
  "schema_version": 1,
  "task": "PT-001",
  "status": "baseline",
  "description": "Minimal cross-runtime contract parity baseline for CarbonOps-API. This file records the public contract surface that Python and .NET parity work must align around without adding generated clients, generated OpenAPI output, or byte-for-byte response fixture comparison in PT-001.",
  "dotnet_source_of_truth": {
    "contracts_project": "src/dotnet/src/CarbonOps.Contracts",
    "api_project": "src/dotnet/src/CarbonOps.Api",
    "contract_tests": "src/dotnet/tests/CarbonOps.Contracts.Tests",
    "api_shape_tests": "src/dotnet/tests/CarbonOps.Api.Tests"
  },
  "python_side": {
    "package_root": "src/python",
    "contract_modules": [
      "src/python/src/carbonops_api/contracts/models.py",
      "src/python/src/carbonops_api/contracts/errors.py",
      "src/python/src/carbonops_api/transport/envelope.py"
    ],
    "current_routes": [
      "GET /health",
      "GET /factors",
      "GET /factors/{factor_id}"
    ],
    "status": "Python has a legacy read-only contract foundation for /factors and transport envelopes. It does not yet implement the modern /carbon-factors import, auth, rate limiting, audit, or /v1 route surface."
  },
  "route_families": [
    {
      "name": "carbon_factor_read_legacy",
      "runtime": ".NET",
      "authentication": "public",
      "rate_limit_policy": "read",
      "routes": [
        "GET /carbon-factors",
        "GET /carbon-factors/search",
        "GET /carbon-factors/{factorId}"
      ]
    },
    {
      "name": "carbon_factor_read_v1",
      "runtime": ".NET",
      "authentication": "public",
      "rate_limit_policy": "read",
      "routes": [
        "GET /v1/carbon-factors",
        "GET /v1/carbon-factors/search",
        "GET /v1/carbon-factors/{factorId}"
      ]
    },
    {
      "name": "carbon_factor_import_legacy",
      "runtime": ".NET",
      "authentication": "api_key",
      "required_header": "X-Api-Key",
      "rate_limit_policy": "import",
      "routes": [
        "POST /carbon-factors/import"
      ]
    },
    {
      "name": "carbon_factor_import_v1",
      "runtime": ".NET",
      "authentication": "api_key",
      "required_header": "X-Api-Key",
      "rate_limit_policy": "import",
      "routes": [
        "POST /v1/carbon-factors/import"
      ]
    },
    {
      "name": "operational",
      "runtime": ".NET",
      "authentication": "public",
      "rate_limit_policy": "none",
      "routes": [
        "GET /health",
        "GET /health/live",
        "GET /health/ready",
        "GET /version"
      ],
      "versioning": "unversioned"
    },
    {
      "name": "python_legacy_read",
      "runtime": "Python",
      "authentication": "public",
      "routes": [
        "GET /health",
        "GET /factors",
        "GET /factors/{factor_id}"
      ],
      "versioning": "legacy-python-local-adapter"
    }
  ],
